TRACEAML_FALKORDB_HOST=localhost
TRACEAML_FALKORDB_PORT=6379
# The full HI-Small graph, under the contract name, so every scored alert can be
# investigated. Load it with make graph-load GRAPH_NAME=traceaml (idempotent merge
# mode); a fresh load in create mode took about 9 minutes and about 3.5 GB in FalkorDB.
TRACEAML_GRAPH_NAME=traceaml
TRACEAML_API_ORIGIN=http://127.0.0.1:8000
# Detection results served by /api/benchmarks default to docs/benchmarks/iteration-2-detection.json.
# Set TRACEAML_GRAPH_METRICS_PATH only to merge extra models (for example an Iteration 1 graph-ablation run).
TRACEAML_PERFORMANCE_PATH=docs/benchmarks/iteration-2-performance.json
# Hard-block rule (ADR-023): scores at or above this are a simulated block the agent
# cannot reverse. A placeholder, not chosen from validation labels. Leave blank to disable.
TRACEAML_BLOCK_THRESHOLD=0.999
TRACEAML_GRAPH_QUERY_TIMEOUT_MS=5000
TRACEAML_GRAPH_POOL_SIZE=16
TRACEAML_CASE_DB_PATH=data/cases/cases.db

# Optional investigation report agent (Gemini). Leave LLM_API_KEY blank to keep it off.
# The agent runs only for requests with "use_llm": true; any failure falls back to the
# deterministic report. Create a key in Google AI Studio (https://aistudio.google.com/apikey).
# Never commit a real key: .env is ignored by git, this example file is not.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_TOOL_CALLS=6
# LLM_MAX_ROUNDS=3
# LLM_MAX_OUTPUT_TOKENS=1500
# Optional USD prices per million tokens. Cost is reported only when both are set.
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
