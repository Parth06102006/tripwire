# Public entry point: TLS (Let's Encrypt) and routing. There is no password
# prompt here: sign-in is Better Auth in the web app (Google and GitHub, an
# access list), and the API verifies the signed token every request carries.
#
#   /api/auth/*  -> web:3000   sign-in, session and token endpoints
#   /api/*       -> api:8000   straight to the API, so a long review stream is
#                              not cut by the Next.js proxy's 30 second limit
#   everything else -> web:3000

{
	email {$ACME_EMAIL}
}

{$TRACEAML_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/auth/* {
		reverse_proxy web:3000
	}

	# The agent review is a server-sent event stream: never buffer it, and
	# allow long reviews when the LLM agent is on.
	handle /api/investigations/stream {
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				read_timeout 5m
			}
		}
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
