# Copy to deploy/.env.production on the server (never commit the copy).
# Read by docker compose (variables below) and by the API container (env_file).

# --- Public entry (Caddy) ---------------------------------------------------
# DNS A record of this name must point at the instance's Elastic IP.
TRACEAML_DOMAIN=traceaml.example.com
ACME_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443

# --- Sign-in (Better Auth, ADR-027) -----------------------------------------
# Create OAuth clients in the Google Cloud console and/or GitHub developer settings.
# Authorised redirect URIs (exact):
#   https://<TRACEAML_DOMAIN>/api/auth/callback/google
#   https://<TRACEAML_DOMAIN>/api/auth/callback/github
# Set the secrets through deploy/scripts/fetch-secrets.sh, not in this file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# At least 32 characters. Generate with: openssl rand -base64 32. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Who may sign in: comma separated addresses and @domain entries. Empty allows nobody.
# Use * to open it to anyone with a verified email (a public demo); the per-user limits still apply.
AUTH_ALLOWED_EMAILS=ops@example.com,@example.com
# Investigations per user, rolling windows. The defaults are 10 an hour and 20 a day.
TRACEAML_INVESTIGATION_LIMIT_HOUR=10
TRACEAML_INVESTIGATION_LIMIT_DAY=20

# --- Release ----------------------------------------------------------------
IMAGE_PREFIX=traceaml
RELEASE=2026-10-17
ARTIFACTS_DIR=/srv/traceaml/artifacts
GRAPH_INPUT_DIR=/srv/traceaml/graph-input
FALKORDB_MEMORY_LIMIT=10g
GRAPH_LOAD_MODE=create

# --- API (TRACEAML_*) ---------------------------------------------------------
TRACEAML_GRAPH_NAME=traceaml
TRACEAML_GRAPH_QUERY_TIMEOUT_MS=5000
TRACEAML_GRAPH_POOL_SIZE=16
TRACEAML_SCORE_ARTIFACT=artifacts/baselines/inference_scores.parquet
TRACEAML_BASELINE_CONFIG_PATH=artifacts/baselines/baseline_config.json
TRACEAML_PERFORMANCE_PATH=docs/benchmarks/iteration-2-performance.json
# Hard-block rule (ADR-023). A placeholder: set it from validation precision.
TRACEAML_BLOCK_THRESHOLD=0.999
TRACEAML_AGENT_TOOL_TRANSPORT=mcp

# --- Optional Gemini agent ----------------------------------------------------
# Leave LLM_API_KEY empty to run the deterministic policy agent only.
# Prefer injecting the key from AWS Secrets Manager / SSM at deploy time
# (deploy/scripts/fetch-secrets.sh) over writing it here.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
